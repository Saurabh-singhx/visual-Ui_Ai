{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "visual-ui-tauri",
  "version": "1.0.0",
  "identifier": "com.visualui.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Visual UI Tauri",
        "width": 1024,
        "height": 768,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
